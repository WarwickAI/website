---
import { LayersAndParameters, NeuronsAddUp, OneNeuron } from './NeuronDiagrams'

interface Props {
  diagram: 'one-neuron' | 'neurons-add-up' | 'layers-and-parameters'
}

const { diagram } = Astro.props
---

{diagram === 'one-neuron' && <OneNeuron client:visible />}
{diagram === 'neurons-add-up' && <NeuronsAddUp client:visible />}
{diagram === 'layers-and-parameters' && <LayersAndParameters client:visible />}
