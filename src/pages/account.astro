---
import AccountPanel from '@/components/AccountPanel'
import AccountTeams from '@/components/AccountTeams.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import GithubLogin from '@/components/GithubLogin.astro'
import LogOutButton from '@/components/LogOutButton'
import PageHead from '@/components/PageHead.astro'
import AvatarComponent from '@/components/ui/avatar'
import Layout from '@/layouts/Layout.astro'
import { auth } from '@/lib/auth'

// GitHub's install redirect and teammates' links land here. Signing in is entering
export const prerender = false

Astro.response.headers.set('Cache-Control', 'private, no-store')

const session = await auth.api.getSession({ headers: Astro.request.headers })
const installationId =
  Number(Astro.url.searchParams.get('installation_id')) || null
// Keeps only installation_id, as better-auth refuses some characters
const returnTo = installationId
  ? `/account?installation_id=${installationId}`
  : '/account'
---

<Layout class="max-w-3xl" particles>
  <PageHead
    slot="head"
    title="Your account"
    description="Your Warwick AI account and competition teams"
    noindex
  />
  <Breadcrumbs items={[{ label: 'Account', icon: 'lucide:user' }]} />

  <section class="mt-6 flex flex-col gap-4">
    <h1 class="text-3xl font-medium">Your account</h1>
    {
      session ? (
        <>
          <div class="bg-background/75 flex items-center gap-4 rounded-xl border p-4">
            <AvatarComponent
              client:load
              src={session.user.image || undefined}
              alt={session.user.name || 'User'}
              fallback={session.user.name?.[0] || 'U'}
              className="size-12 shrink-0 rounded-full"
            />
            <div class="min-w-0 grow">
              <p class="truncate text-lg font-medium">{session.user.name}</p>
              {session.user.email && (
                <p class="text-muted-foreground truncate text-sm">
                  {session.user.email}
                </p>
              )}
              <GithubLogin server:defer>
                <div
                  slot="fallback"
                  class="bg-foreground/10 mt-1.5 h-3 w-20 animate-pulse rounded"
                />
              </GithubLogin>
            </div>
            <LogOutButton
              client:load
              redirectTo={returnTo}
              className="shrink-0"
            />
          </div>
          <h2 class="mt-2 text-2xl font-medium">Your teams</h2>
          <AccountTeams server:defer installationId={installationId}>
            <div
              slot="fallback"
              role="status"
              class="bg-background/75 flex flex-col gap-3 rounded-xl border p-4"
            >
              <span class="sr-only">Loading your teams</span>
              <div class="bg-foreground/10 h-5 w-40 animate-pulse rounded" />
              <div class="bg-foreground/10 h-4 w-20 animate-pulse rounded" />
              <div class="bg-foreground/10 h-4 w-56 animate-pulse rounded" />
            </div>
          </AccountTeams>
        </>
      ) : (
        <AccountPanel
          client:load
          signedIn={false}
          teams={[]}
          problem={null}
          returnTo={returnTo}
        />
      )
    }
  </section>
</Layout>
