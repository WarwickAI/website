---
import type { ISourceOptions } from '@tsparticles/engine'

const options: ISourceOptions = {
  autoPlay: true,
  detectRetina: true,
  fpsLimit: 90,
  fullScreen: {
    zIndex: -1,
  },
  interactivity: {
    detectsOn: 'window',
    events: {
      onClick: {
        enable: true,
        mode: 'repulse',
      },
      resize: {
        enable: true,
        delay: 0.1,
      },
    },
    modes: {
      repulse: {
        distance: 200,
        duration: 0.4,
      },
    },
  },
  particles: {
    color: {
      value: '#6D60C1',
    },
    links: {
      color: {
        value: '#6D60C1',
      },
      distance: 300,
      enable: true,
      opacity: 0.2,
      width: 1,
    },
    move: {
      direction: 'none',
      enable: true,
      outModes: 'out',
      random: true,
      speed: 1,
      straight: false,
    },
    number: {
      density: {
        enable: true,
      },
      value: 70,
    },
    opacity: {
      value: 0.5,
    },
    shape: {
      type: 'circle',
    },
    size: {
      value: {
        max: 3,
        min: 1,
      },
    },
  },
  pauseOnBlur: true,
  pauseOnOutsideViewport: true,
}
---

<div id="tsparticles" data-options={JSON.stringify(options)} transition:persist>
</div>

<script>
  import { tsParticles, type ISourceOptions } from '@tsparticles/engine'
  import { loadSlim } from '@tsparticles/slim'

  const ready = loadSlim(tsParticles)

  // The router only runs this script on the first page with particles, so
  // they're started on every page it changes to. Between two pages with
  // particles the div is kept, canvas and all, so they carry on as they were.
  document.addEventListener('astro:page-load', async () => {
    const el = document.getElementById('tsparticles')
    if (el?.querySelector('canvas')) return

    // The last page's particles, still drawing on a canvas that's gone
    for (const container of [...tsParticles.items]) container.destroy()

    if (el) {
      const options = JSON.parse(el.dataset.options!) as ISourceOptions
      await ready
      await tsParticles.load({ id: 'tsparticles', options })
    }
  })
</script>
