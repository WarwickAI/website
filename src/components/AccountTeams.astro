---
import AccountPanel, { type AccountTeam } from '@/components/AccountPanel'
import { auth } from '@/lib/auth'
import {
  githubLogins,
  joinFromInstallation,
  myTeams,
  refreshMyRepos,
  suggestedTeammates,
} from '@/lib/competition/account'
import { syncUser } from '@/lib/competition/membership-store'

interface Props {
  installationId: number | null
}

// Deferred from /account, as asking GitHub takes a second or two
Astro.response.headers.set('Cache-Control', 'private, no-store')

const { installationId } = Astro.props
const headers = Astro.request.headers
const session = await auth.api.getSession({ headers })

let problem: string | null = null
// null if they couldn't be loaded
let teams: AccountTeam[] | null = []
if (session) {
  const userId = session.user.id
  try {
    if (installationId) {
      const result = await joinFromInstallation(userId, installationId, headers)
      if (!result.ok) problem = result.reason
    }
    // Who can push may have changed since the last push
    await refreshMyRepos(userId, headers)
    await syncUser(userId)
  } catch (error) {
    console.error('Error joining from GitHub:', error)
    problem ??=
      'Something went wrong talking to GitHub. Refresh the page to try again.'
  }

  try {
    const mine = await myTeams(userId)
    const [logins, suggestions] = await Promise.all([
      githubLogins(userId, headers, [
        ...new Set(mine.flatMap((t) => t.unclaimedGithubUserIds)),
      ]),
      suggestedTeammates(mine),
    ])
    teams = mine.map((team) => ({
      ...team,
      unclaimedLogins: team.unclaimedGithubUserIds
        .map((id) => logins.get(id))
        .filter((login): login is string => !!login),
      suggestedLogins: suggestions.get(team.projectId) ?? [],
    }))
  } catch (error) {
    console.error('Error loading teams:', error)
    teams = null
    problem ??= "We couldn't load your teams. Refresh the page to try again."
  }
}
---

{
  session && (
    <AccountPanel
      client:load
      signedIn
      teams={teams}
      problem={problem}
      returnTo="/account"
    />
  )
}
