---
import AuthorAvatars from '@/components/AuthorAvatars'
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import type { ContentCollectionConfig, ContentEntry } from '@/lib/collections'
import {
  getCombinedReadingTime,
  getEntryAuthorIds,
  getEntryTags,
  getSubentryCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import Link from './Link.astro'

interface Props {
  entry: ContentEntry
  config: ContentCollectionConfig
  masonryCard?: boolean
}

const { entry, config, masonryCard } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(config, entry.id)
const authors = await parseAuthors(await getEntryAuthorIds(config, entry.id))
const tags = await getEntryTags(config, entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubentryCount(config, entry.id) : 0
---

<div
  class="hover:bg-secondary/50 relative isolate rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <div
    class={masonryCard
      ? 'flex flex-col gap-4'
      : 'flex flex-col gap-4 sm:flex-row'}
  >
    {
      entry.data.image && (
        <div class="max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">
        <Link
          href={`${config.basePath}/${entry.id}`}
          class="after:absolute after:inset-0 after:z-10 after:rounded-xl"
        >
          {entry.data.title}
        </Link>
      </h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div class="mb-2 -ml-1 overflow-x-clip pl-1">
        <div
          class="text-muted-foreground -ml-[9px] flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs"
        >
          {
            authors.length > 0 && (
              <div class="relative z-20 flex items-center gap-x-2">
                <Separator orientation="vertical" className="h-4!" />
                {authors.length === 1 ? (
                  <a
                    href={
                      authors[0].isRegistered
                        ? `/authors/${authors[0].id}`
                        : undefined
                    }
                    class="hover:text-foreground flex items-center gap-x-1.5 transition-colors duration-300 ease-in-out"
                  >
                    <AvatarComponent
                      client:load
                      src={authors[0].avatar}
                      alt={authors[0].name}
                      fallback={authors[0].name[0]}
                      className="size-5 rounded-full"
                    />
                    <span>{authors[0].name}</span>
                  </a>
                ) : (
                  <AuthorAvatars client:load authors={authors} />
                )}
              </div>
            )
          }
          <div class="flex items-center gap-x-2">
            <Separator orientation="vertical" className="h-4!" />
            <span>{formattedDate}</span>
          </div>
          <div class="flex items-center gap-x-2">
            <Separator orientation="vertical" className="h-4!" />
            <span>{readTime}</span>
          </div>
          {
            subpostCount > 0 && (
              <div class="flex items-center gap-x-2">
                <Separator orientation="vertical" className="h-4!" />
                <span class="flex items-center gap-1">
                  <Icon name="lucide:file-text" class="size-3" />
                  {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
                </span>
              </div>
            )
          }
        </div>
      </div>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <Badge variant="secondary" className="flex items-center gap-x-1">
                <Icon name="lucide:hash" class="size-3" />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
