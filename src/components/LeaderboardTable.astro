---
import Link from '@/components/Link.astro'
import AvatarComponent from '@/components/ui/avatar'
import UserRank from '@/components/UserRank'
import ScrollingNames from '@/components/ScrollingNames'
import { buttonVariants } from '@/components/ui/button'
import { formatDate, formatNumber, cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { loadCompetition } from '@/lib/competition/data'
import { buildLeaderboard, type Leaderboard, type LeaderboardRow } from '@/lib/competition/leaderboard'
import { teamStatuses } from '@/lib/competition/team-status'

export const prerender = false

interface Props {
  project: string
  className?: string
  limit?: number
}

const {
  project: projectId,
  className,
  limit
} = Astro.props

// ISR: Cache at Vercel edge for 1 minute, serve stale while revalidating for up to 5 minutes
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300'
)

let project: { startDate: Date; endDate: Date | null } | null = null
let board: Leaderboard = { ranked: [], late: [], cantRank: [], disqualified: [] }

try {
  const data = await loadCompetition(projectId)
  project = data.project
  board = buildLeaderboard(data, teamStatuses(data, new Date()))
} catch (error) {
  console.error('Error fetching leaderboard data:', error)
}

// After the end, unclaimed teams can't be claimed
const ended = !!project?.endDate && new Date() > project.endDate

type Section = 'ranked' | 'late' | 'cantRank' | 'disqualified'
type Entry = LeaderboardRow & { section: Section; reason?: 'unclaimed' | 'onHold' }

// Ranked, then late, then can't rank yet, then disqualified
const entries: Entry[] = [
  ...board.ranked.map((row) => ({ ...row, section: 'ranked' as const })),
  ...board.late.map((row) => ({ ...row, section: 'late' as const })),
  ...board.cantRank.map((row) => ({ ...row, section: 'cantRank' as const })),
  ...board.disqualified.map((row) => ({ ...row, section: 'disqualified' as const })),
]
const totalSubmissions = entries.length
const shownEntries = limit ? entries.slice(0, limit) : entries
const hasMore = limit ? totalSubmissions > limit : false

const userRankData = board.ranked.map((row) => ({
  userIds: row.members.map((m) => m.userId),
  score: row.score,
}))

const isPodium = (rank: number | null) => rank !== null && rank <= 3

const getRankStyles = (rank: number | null) => {
  if (rank === 1) return 'bg-gradient-to-r from-amber-500 to-yellow-500 text-white border-transparent shadow-sm'
  if (rank === 2) return 'bg-gradient-to-r from-slate-400 to-slate-500 text-white border-transparent shadow-sm'
  if (rank === 3) return 'bg-gradient-to-r from-amber-700 to-orange-800 text-white border-transparent shadow-sm'
  return 'bg-muted/50 text-muted-foreground border-border'
}

const getRankColor = (rank: number | null) => {
  if (rank === 1) return 'text-amber-600 dark:text-amber-400'
  if (rank === 2) return 'text-slate-600 dark:text-slate-400'
  if (rank === 3) return 'text-orange-700 dark:text-orange-600'
  return 'text-muted-foreground'
}

// Below the podium, just the number
const getRankIcon = (entry: Entry): string | null => {
  if (entry.section === 'late') return 'lucide:clock-alert'
  if (entry.section === 'disqualified') return 'lucide:ban'
  if (entry.section === 'cantRank')
    return entry.reason === 'onHold' ? 'lucide:circle-pause' : 'lucide:user-plus'
  if (entry.rank === 1) return 'lucide:trophy'
  if (entry.rank === 2) return 'lucide:medal'
  if (entry.rank === 3) return 'lucide:award'
  return null
}

const rankTitles: Record<string, string> = {
  late: 'Submitted after the deadline',
  unclaimed: "Unclaimed: nobody on this team has signed in yet",
  onHold: "On hold: someone on another team can push to this team's repository",
  disqualified: 'Disqualified',
}
const rankTitle = (entry: Entry) => rankTitles[entry.reason ?? entry.section]

// Each section after the first starts with a divider
const dividers: Record<Exclude<Section, 'ranked'>, { icon: string; label: string }> = {
  late: { icon: 'lucide:clock-alert', label: 'Submitted after the deadline' },
  cantRank: { icon: 'lucide:circle-pause', label: "Can't rank yet" },
  disqualified: { icon: 'lucide:ban', label: 'Disqualified' },
}
const dividerAfter = (index: number) => {
  const next = shownEntries[index + 1]
  if (!next || next.section === shownEntries[index].section) return null
  return dividers[next.section as Exclude<Section, 'ranked'>]
}

// Competitions scored in whole numbers, such as tournament points, don't need decimals
const scoreDecimals = entries.every((e) => Number.isInteger(e.score)) ? 0 : 2

const formatScore = (score: number | null) => {
  if (score === null) return 'Pending'
  return formatNumber(score, scoreDecimals)
}

const timeAgo = (date: Date) => {
  const seconds = Math.floor((new Date().getTime() - date.getTime()) / 1000)
  if (seconds < 60) return 'just now'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60) return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}h ago`
  const days = Math.floor(hours / 24)
  if (days < 7) return `${days}d ago`
  return formatDate(date)
}
---

<div class={cn('flex flex-col gap-4 overflow-hidden', className)}>
  <div class="flex flex-col gap-1 text-xs sm:text-sm text-muted-foreground">
    <div class="flex items-center gap-2">
      <Icon name="lucide:users" class="size-3 sm:size-4" />
      <span>{totalSubmissions} submission{totalSubmissions !== 1 ? 's' : ''}</span>
    </div>
    {project?.endDate && (
      <div class="flex items-center gap-2 hidden sm:flex">
        <Icon name="lucide:calendar-clock" class="size-4" />
        <span>Deadline: {formatDate(new Date(project.endDate))}</span>
      </div>
    )}
    <UserRank client:only="react" transition:persist submissions={userRankData} decimals={scoreDecimals} />
  </div>

  {shownEntries.length > 0 ? (
    <div class="flex flex-col overflow-hidden">
      {shownEntries.map((entry, index) => {
        const { rank, lateBest, section } = entry
        const podium = isPodium(rank)
        const nextDivider = dividerAfter(index)
        const disqualified = section === 'disqualified'
        // Unclaimed teams have no names, so show the repo
        const names = entry.members.length
          ? entry.members.map((m) => m.name || 'Anonymous')
          : [entry.repoFullName]

        const rowBackground =
          rank === 1
            ? 'bg-gradient-to-r from-amber-400/10 via-amber-400/20 to-amber-400/10'
            : rank === 2
              ? 'bg-gradient-to-r from-slate-400/10 via-slate-400/20 to-slate-400/10'
              : rank === 3
                ? 'bg-gradient-to-r from-orange-500/10 via-orange-500/20 to-orange-500/10'
                : 'hover:bg-muted/20'

        return (
          <>
            <div class={cn(
              'group transition-colors duration-200 py-4 sm:py-5 px-2 sm:px-3 rounded-md overflow-hidden',
              rowBackground,
              disqualified && 'opacity-70'
            )}>
              <div class="flex items-start gap-3 min-w-0">
                <div class="flex-shrink-0">
                  <div
                    class={cn(
                      'flex items-center justify-center w-12 h-8.5 rounded-md border font-semibold text-base px-2 gap-1',
                      getRankStyles(rank)
                    )}
                    title={rankTitle(entry)}
                  >
                    {getRankIcon(entry) && (
                      <Icon
                        name={getRankIcon(entry)!}
                        class={cn(
                          'size-4 shrink-0',
                          podium ? 'text-white' : 'text-muted-foreground'
                        )}
                      />
                    )}
                    {rank !== null && <span>{rank}</span>}
                  </div>
                </div>

                <div class="flex-1 min-w-0 overflow-hidden flex flex-col gap-1">
                  <div class="flex -space-x-2">
                    {entry.members.slice(0, 5).map((m) => (
                      <AvatarComponent
                        client:load
                        src={m.image || undefined}
                        alt={m.name || 'User'}
                        fallback={m.name?.[0] || 'U'}
                        className="size-8 rounded-full border-2 border-background"
                      />
                    ))}
                    {entry.members.length > 5 && (
                      <div class="flex size-8 items-center justify-center rounded-full bg-muted border-2 border-background text-xs font-medium">
                        +{entry.members.length - 5}
                      </div>
                    )}
                    {entry.unclaimedCount > 0 && (
                      <div class="flex size-8 items-center justify-center rounded-full bg-muted/50 border-2 border-background border-dashed text-xs text-muted-foreground">
                        +{entry.unclaimedCount}
                      </div>
                    )}
                  </div>

                  {/* An unclaimed team's note says this already */}
                  <ScrollingNames
                    client:load
                    names={names}
                    unlinkedCount={entry.reason === 'unclaimed' ? 0 : entry.unclaimedCount}
                  />

                  {entry.reason === 'unclaimed' && (
                    <p class="flex items-center gap-1 text-[11px] sm:text-xs text-muted-foreground">
                      <Icon name="lucide:user-plus" class="size-3" />
                      {ended ? (
                        <span>Unclaimed: nobody on this team signed in</span>
                      ) : (
                        <span>Unclaimed: <Link href="/account" underline>sign in</Link> to enter</span>
                      )}
                    </p>
                  )}
                  {entry.reason === 'onHold' && (
                    <p class="flex items-center gap-1 text-[11px] sm:text-xs text-muted-foreground">
                      <Icon name="lucide:circle-pause" class="size-3" />
                      On hold: shares a member with another team
                    </p>
                  )}

                  <p class="text-[11px] sm:text-xs text-muted-foreground">
                    {timeAgo(new Date(entry.submittedAt))}
                  </p>
                </div>

                <div class="text-right flex-shrink-0">
                  {disqualified ? (
                    <p
                      class="font-bold text-lg sm:text-xl text-muted-foreground"
                      title={entry.publicNotes.join('; ') || 'Disqualified'}
                    >
                      DSQ
                    </p>
                  ) : (
                    <>
                      <p class={cn(
                        'font-bold text-lg sm:text-xl',
                        podium ? getRankColor(rank) : 'text-foreground'
                      )}>
                        {formatScore(entry.score)}
                      </p>
                      <p class="text-[10px] sm:text-xs text-muted-foreground">pts</p>
                    </>
                  )}
                  {/* Penalties are private; only public notes show */}
                  {!disqualified && entry.publicNotes.length > 0 && (
                    <p class="mt-1 flex items-center justify-end gap-1 text-[10px] sm:text-xs text-muted-foreground">
                      <Icon name="lucide:info" class="size-3" />
                      {entry.publicNotes.join('; ')}
                    </p>
                  )}
                  {lateBest && (
                    <p
                      class="mt-1 flex items-center justify-end gap-1 text-[10px] sm:text-xs text-muted-foreground"
                      title={`Scored ${formatScore(lateBest.score)} after the deadline, on ${formatDate(new Date(lateBest.submittedAt))}`}
                    >
                      <Icon name="lucide:clock-alert" class="size-3" />
                      {formatScore(lateBest.score)} late
                    </p>
                  )}
                </div>
              </div>
            </div>
            {nextDivider ? (
              <div class="flex items-center gap-3 py-2 text-[11px] sm:text-xs text-muted-foreground">
                <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border/50" />
                <span class="flex items-center gap-1">
                  <Icon name={nextDivider.icon} class="size-3" />
                  {nextDivider.label}
                </span>
                <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border/50" />
              </div>
            ) : index < shownEntries.length - 1 && (
              <div class="mx-auto max-w-2xl">
                <div class="h-px bg-gradient-to-r from-transparent via-border/50 to-transparent" />
              </div>
            )}
          </>
        )
      })}
    </div>
  ) : (
    <div class="py-10 sm:py-14 text-center">
      <Icon name="lucide:trophy" class="mx-auto mb-3 text-muted-foreground/20 size-14 sm:size-20" />
      {project?.startDate && new Date(project.startDate) > new Date() ? (
        <>
          <p class="text-muted-foreground text-base">Competition coming soon!</p>
          <p class="text-muted-foreground text-sm mt-1">Submissions will open on {formatDate(new Date(project.startDate))}</p>
        </>
      ) : (
        <>
          <p class="text-muted-foreground text-base">No submissions yet</p>
          <p class="text-muted-foreground text-sm mt-1">Be the first to submit!</p>
        </>
      )}
    </div>
  )}

  {hasMore && (
    <div class="flex justify-center mt-4">
      <Link
        href={`/projects/${projectId}/scores`}
        class={cn(buttonVariants({ variant: 'outline' }), 'group')}
      >
        View all {totalSubmissions} submissions
        <Icon name="lucide:arrow-right" class="ml-2 size-4 transition-transform group-hover:translate-x-1" />
      </Link>
    </div>
  )}
</div>
