---
import Link from '@/components/Link.astro'
import AvatarComponent from '@/components/ui/avatar'
import UserRank from '@/components/UserRank'
import ScrollingNames from '@/components/ScrollingNames'
import { buttonVariants } from '@/components/ui/button'
import { formatDate, cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { buildLeaderboard } from '@/lib/leaderboard'
import { db, eq, Project, Submission, Contribution, User } from 'astro:db'

export const prerender = false

interface Props {
  project: string
  className?: string
  limit?: number
}

const {
  project: projectId,
  className,
  limit
} = Astro.props

// ISR: Cache at Vercel edge for 1 minute, serve stale while revalidating for up to 5 minutes
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300'
)

let project = null
let submissionsWithContributions: any[] = []

try {
  const results = await Promise.all([
    db
      .select()
      .from(Project)
      .where(eq(Project.id, projectId))
      .get(),
    db
      .select({
        submissionId: Submission.id,
        score: Submission.score,
        submittedAt: Submission.submittedAt,
        githubUserId: Contribution.githubUserId,
        userId: Contribution.userId,
        userName: User.name,
        userImage: User.image,
      })
      .from(Submission)
      .leftJoin(Contribution, eq(Submission.id, Contribution.submissionId))
      .leftJoin(User, eq(Contribution.userId, User.id))
      .where(eq(Submission.projectId, projectId))
  ])

  project = results[0]
  submissionsWithContributions = results[1]
} catch (error) {
  console.error('Error fetching leaderboard data:', error)
}

const submissionMap = new Map<string, {
  id: string
  score: number
  submittedAt: Date
  githubUserIds: number[]
  contributors: Array<{ userId: string | null; userName: string | null; userImage: string | null }>
  unlinkedCount: number
}>()

for (const row of submissionsWithContributions) {
  if (!submissionMap.has(row.submissionId)) {
    submissionMap.set(row.submissionId, {
      id: row.submissionId,
      score: row.score,
      submittedAt: row.submittedAt,
      githubUserIds: [],
      contributors: [],
      unlinkedCount: 0,
    })
  }
  const submission = submissionMap.get(row.submissionId)!
  if (row.githubUserId === null) continue
  submission.githubUserIds.push(row.githubUserId)
  if (row.userId === null) {
    submission.unlinkedCount++
  } else {
    submission.contributors.push({
      userId: row.userId,
      userName: row.userName,
      userImage: row.userImage,
    })
  }
}

const { ranked, late } = buildLeaderboard(Array.from(submissionMap.values()), {
  startDate: project?.startDate ?? null,
  endDate: project?.endDate ?? null,
})

// Late entries come after the rankings, without a rank of their own
const entries = [
  ...ranked.map((entry, index) => ({ ...entry, rank: index + 1 as number | null })),
  ...late.map((submission) => ({ submission, lateBest: null, rank: null })),
]
const totalSubmissions = entries.length
const shownEntries = limit ? entries.slice(0, limit) : entries
const hasMore = limit ? totalSubmissions > limit : false

const userRankData = ranked.map(({ submission }) => ({
  userIds: submission.contributors.map((c) => c.userId),
  score: submission.score,
}))

const isPodium = (rank: number | null) => rank !== null && rank <= 3

const getRankStyles = (rank: number | null) => {
  if (rank === 1) return 'bg-gradient-to-r from-amber-500 to-yellow-500 text-white border-0 shadow-sm'
  if (rank === 2) return 'bg-gradient-to-r from-slate-400 to-slate-500 text-white border-0 shadow-sm'
  if (rank === 3) return 'bg-gradient-to-r from-amber-700 to-orange-800 text-white border-0 shadow-sm'
  return 'bg-muted/50 text-muted-foreground border-border'
}

const getRankColor = (rank: number | null) => {
  if (rank === 1) return 'text-amber-600 dark:text-amber-400'
  if (rank === 2) return 'text-slate-600 dark:text-slate-400'
  if (rank === 3) return 'text-orange-700 dark:text-orange-600'
  return 'text-muted-foreground'
}

const getRankIcon = (rank: number | null) => {
  if (rank === null) return 'lucide:clock-alert'
  if (rank === 1) return 'lucide:trophy'
  if (rank === 2) return 'lucide:medal'
  if (rank === 3) return 'lucide:award'
  return 'lucide:hash'
}

const formatScore = (score: number | null) => {
  if (score === null) return 'Pending'
  return score.toFixed(2)
}

const timeAgo = (date: Date) => {
  const seconds = Math.floor((new Date().getTime() - date.getTime()) / 1000)
  if (seconds < 60) return 'just now'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60) return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}h ago`
  const days = Math.floor(hours / 24)
  if (days < 7) return `${days}d ago`
  return formatDate(date)
}
---

<div class={cn('flex flex-col gap-4 overflow-hidden', className)}>
  <div class="flex flex-col gap-1 text-xs sm:text-sm text-muted-foreground">
    <div class="flex items-center gap-2">
      <Icon name="lucide:users" class="size-3 sm:size-4" />
      <span>{totalSubmissions} submission{totalSubmissions !== 1 ? 's' : ''}</span>
    </div>
    {project?.endDate && (
      <div class="flex items-center gap-2 hidden sm:flex">
        <Icon name="lucide:calendar-clock" class="size-4" />
        <span>Deadline: {formatDate(new Date(project.endDate))}</span>
      </div>
    )}
    <UserRank client:only="react" transition:persist submissions={userRankData} />
  </div>

  {shownEntries.length > 0 ? (
    <div class="flex flex-col overflow-hidden">
      {shownEntries.map(({ submission, lateBest, rank }, index) => {
        const podium = isPodium(rank)
        const nextIsFirstLate = rank !== null && shownEntries[index + 1]?.rank === null

        const rowBackground =
          rank === 1
            ? 'bg-gradient-to-r from-amber-400/10 via-amber-400/20 to-amber-400/10'
            : rank === 2
              ? 'bg-gradient-to-r from-slate-400/10 via-slate-400/20 to-slate-400/10'
              : rank === 3
                ? 'bg-gradient-to-r from-orange-500/10 via-orange-500/20 to-orange-500/10'
                : 'hover:bg-muted/20'

        return (
          <>
            <div class={cn(
              'group transition-colors duration-200 py-4 sm:py-5 px-2 sm:px-3 rounded-md overflow-hidden',
              rowBackground
            )}>
              <div class="flex items-start gap-3 min-w-0">
                <div class="flex-shrink-0">
                  <div
                    class={cn(
                      'flex items-center justify-center w-10 py-1 rounded-md border font-semibold text-base px-2 gap-1',
                      getRankStyles(rank)
                    )}
                    title={rank === null ? 'Submitted after the deadline' : undefined}
                  >
                    <Icon
                      name={getRankIcon(rank)}
                      class={cn(
                        'size-4',
                        podium ? 'text-white' : 'text-muted-foreground'
                      )}
                    />
                    {rank !== null && <span>{rank}</span>}
                  </div>
                </div>

                <div class="flex-1 min-w-0 overflow-hidden flex flex-col gap-1">
                  <div class="flex -space-x-2">
                    {submission.contributors.slice(0, 5).map((c) => (
                      <AvatarComponent
                        client:load
                        src={c.userImage || undefined}
                        alt={c.userName || 'User'}
                        fallback={c.userName?.[0] || 'U'}
                        className="size-8 rounded-full border-2 border-background"
                      />
                    ))}
                    {submission.contributors.length > 5 && (
                      <div class="flex size-8 items-center justify-center rounded-full bg-muted border-2 border-background text-xs font-medium">
                        +{submission.contributors.length - 5}
                      </div>
                    )}
                    {submission.unlinkedCount > 0 && (
                      <div class="flex size-8 items-center justify-center rounded-full bg-muted/50 border-2 border-background border-dashed text-xs text-muted-foreground">
                        +{submission.unlinkedCount}
                      </div>
                    )}
                  </div>

                  <ScrollingNames
                    client:load
                    names={submission.contributors.map((c) => c.userName || 'Anonymous')}
                    unlinkedCount={submission.unlinkedCount}
                  />

                  <p class="text-[11px] sm:text-xs text-muted-foreground">
                    {timeAgo(new Date(submission.submittedAt))}
                  </p>
                </div>

                <div class="text-right flex-shrink-0">
                  <p class={cn(
                    'font-bold text-lg sm:text-xl',
                    podium ? getRankColor(rank) : 'text-foreground'
                  )}>
                    {formatScore(submission.score)}
                  </p>
                  <p class="text-[10px] sm:text-xs text-muted-foreground">pts</p>
                  {lateBest && (
                    <p
                      class="mt-1 flex items-center justify-end gap-1 text-[10px] sm:text-xs text-muted-foreground"
                      title={`Scored ${formatScore(lateBest.score)} after the deadline, on ${formatDate(new Date(lateBest.submittedAt))}`}
                    >
                      <Icon name="lucide:clock-alert" class="size-3" />
                      {formatScore(lateBest.score)} late
                    </p>
                  )}
                </div>
              </div>
            </div>
            {nextIsFirstLate ? (
              <div class="flex items-center gap-3 py-2 text-[11px] sm:text-xs text-muted-foreground">
                <div class="h-px flex-1 bg-gradient-to-r from-transparent to-border/50" />
                <span class="flex items-center gap-1">
                  <Icon name="lucide:clock-alert" class="size-3" />
                  Submitted after the deadline
                </span>
                <div class="h-px flex-1 bg-gradient-to-l from-transparent to-border/50" />
              </div>
            ) : index < shownEntries.length - 1 && (
              <div class="mx-auto max-w-2xl">
                <div class="h-px bg-gradient-to-r from-transparent via-border/50 to-transparent" />
              </div>
            )}
          </>
        )
      })}
    </div>
  ) : (
    <div class="py-10 sm:py-14 text-center">
      <Icon name="lucide:trophy" class="mx-auto mb-3 text-muted-foreground/20 size-14 sm:size-20" />
      {project?.startDate && new Date(project.startDate) > new Date() ? (
        <>
          <p class="text-muted-foreground text-base">Competition coming soon!</p>
          <p class="text-muted-foreground text-sm mt-1">Submissions will open on {formatDate(new Date(project.startDate))}</p>
        </>
      ) : (
        <>
          <p class="text-muted-foreground text-base">No submissions yet</p>
          <p class="text-muted-foreground text-sm mt-1">Be the first to submit!</p>
        </>
      )}
    </div>
  )}

  {hasMore && (
    <div class="flex justify-center mt-4">
      <Link
        href={`/projects/${projectId}/scores`}
        class={cn(buttonVariants({ variant: 'outline' }), 'group')}
      >
        View all {totalSubmissions} submissions
        <Icon name="lucide:arrow-right" class="ml-2 size-4 transition-transform group-hover:translate-x-1" />
      </Link>
    </div>
  )}
</div>
